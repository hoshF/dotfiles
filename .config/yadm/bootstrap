#!/bin/bash
# bootstrap

set -e -o pipefail

# This installer provisions Arch; macOS restores configuration through README.md.
if [ "$(uname -s)" != Linux ] || [ ! -r /etc/os-release ]; then
    echo "Bootstrap supports Arch Linux only. See README.md for macOS configuration recovery." >&2
    exit 1
fi
. /etc/os-release
if [ "${ID:-}" != arch ]; then
    echo "Bootstrap supports Arch Linux only. See README.md for configuration recovery." >&2
    exit 1
fi
if [ "$(id -u)" -eq 0 ]; then
    echo "Run bootstrap as your normal user; privileged operations use sudo." >&2
    exit 1
fi

# Reading local.class through yadm config can trigger automatic alternate updates.
YADM_REPO=$(yadm introspect repo) || exit 1
YADM_CLASSES=$(git --git-dir="$YADM_REPO" config --local --get-all local.class) || YADM_CLASSES=
has_sway=false
has_mac=false
while IFS= read -r class; do
    case "$class" in
        [Ss][Ww][Aa][Yy]) has_sway=true ;;
        [Mm][Aa][Cc]) has_mac=true ;;
    esac
done <<< "$YADM_CLASSES"
if [ "$has_sway" != true ] || [ "$has_mac" = true ]; then
    echo "Bootstrap requires the sway class without a mac class." >&2
    echo "Run: yadm config --replace-all local.class sway && yadm alt" >&2
    exit 1
fi

# Colors & Config
RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
NC='\033[0m'

YADM_DIR="$(dirname "$(realpath "$0")")"
PACKAGE_FILE="$YADM_DIR/packages.yaml"
LOG_FILE="/tmp/bootstrap-$(date +%Y%m%d-%H%M%S).log"

PACMAN_CATEGORIES=("core" "cli_tools" "sway_desktop" "ime" "viewers" "latex" "fonts" "audio" "services" "security")
AUR_CATEGORIES=("browser" "fonts" "ime" "tools" "security")

exec > >(tee -a "$LOG_FILE") 2>&1
echo "Bootstrap log: $LOG_FILE"
echo "YADM Directory: $YADM_DIR"

# Sync
sync_system() {
    echo -e "${GREEN}[0/8] Syncing package databases...${NC}"
    sudo pacman -Syu --noconfirm
}

# yq
check_yq() {
    # Arch's yq is kislyuk/yq (the jq wrapper), not the incompatible Go yq.
    sudo pacman -S --needed --noconfirm yq
    YQ=/usr/bin/yq
    [ -x "$YQ" ] || { echo "Arch's /usr/bin/yq is unavailable." >&2; return 1; }
}

get_packages() {
    local repo="$1"
    local category="$2"
    "$YQ" -r --arg repo "$repo" --arg category "$category" '
        .[$repo][$category]
        | if type == "array" then .[]
          else error("Expected a package array for " + $repo + "." + $category) end
        | if type == "string" and length > 0 then .
          else error("Expected non-empty package strings in " + $repo + "." + $category) end
    ' "$PACKAGE_FILE"
}

# 1. Drivers
install_drivers() {
    echo -e "${GREEN}[1/8] Detecting and installing graphics drivers...${NC}"
    command -v lspci >/dev/null || sudo pacman -S --needed --noconfirm pciutils
    local GPU_INFO=$(lspci | grep -i 'vga\|3d\|display')
    local DRIVER_PKGS=()
    local IS_NVIDIA=false

    if echo "$GPU_INFO" | grep -iq 'amd\|radeon'; then
        echo -e "${BLUE}Detected AMD GPU.${NC}"
        DRIVER_PKGS+=("mesa" "vulkan-radeon" "xf86-video-amdgpu")
    fi

    if echo "$GPU_INFO" | grep -iq 'intel'; then
        echo -e "${BLUE}Detected Intel GPU.${NC}"
        DRIVER_PKGS+=("mesa" "vulkan-intel" "intel-media-driver")
    fi

    if echo "$GPU_INFO" | grep -iq 'nvidia'; then
        echo -e "${BLUE}Detected NVIDIA GPU.${NC}"
        DRIVER_PKGS+=("nvidia-dkms" "nvidia-utils" "egl-wayland" "linux-headers")
        IS_NVIDIA=true
    fi

    if [ ${#DRIVER_PKGS[@]} -eq 0 ]; then
        echo -e "${YELLOW}No specific GPU detected. Defaulting to mesa.${NC}"
        DRIVER_PKGS+=("mesa")
    fi

    echo -e "${BLUE}Installing drivers: ${DRIVER_PKGS[*]}${NC}"
    sudo pacman -S --noconfirm --needed "${DRIVER_PKGS[@]}"

    if [ "$IS_NVIDIA" = true ]; then
        echo -e "${RED}================================================================${NC}"
        echo -e "${RED}⚠️  NVIDIA DKMS INSTALLED! ACTION REQUIRED:                     ${NC}"
        echo -e "${RED}You MUST add the following parameter to your systemd-boot      ${NC}"
        echo -e "${RED}or GRUB kernel parameters line before rebooting:               ${NC}"
        echo -e "${RED}    nvidia-drm.modeset=1                                       ${NC}"
        echo -e "${RED}================================================================${NC}"
    fi
    echo -e "${GREEN}✓ Graphics drivers installed${NC}"
}

# 2. Pacman
install_pacman_packages() {
    echo -e "${GREEN}[2/8] Installing Pacman packages${NC}"

    local packages=() package_lines category pkg
    for category in "${PACMAN_CATEGORIES[@]}"; do
        package_lines=$(get_packages "pacman" "$category") || return 1
        while IFS= read -r pkg; do
            [ -z "$pkg" ] || packages+=("$pkg")
        done <<< "$package_lines"
    done

    if [ ${#packages[@]} -gt 0 ]; then
        echo -e "${BLUE}Installing ${#packages[@]} Pacman packages...${NC}"
        sudo pacman -S --noconfirm --needed "${packages[@]}"
        echo -e "${GREEN}✓ Pacman packages installed${NC}"
    else
        echo -e "${YELLOW}No Pacman packages found. Check your packages.yaml${NC}"
    fi
}

# 3. AUR
install_aur_packages() {
    echo -e "${GREEN}[3/8] Installing AUR packages${NC}"

    local aur_packages=() package_lines category pkg
    for category in "${AUR_CATEGORIES[@]}"; do
        package_lines=$(get_packages "aur" "$category") || return 1
        while IFS= read -r pkg; do
            [ -z "$pkg" ] || aur_packages+=("$pkg")
        done <<< "$package_lines"
    done
    if [ ${#aur_packages[@]} -eq 0 ]; then
        echo -e "${YELLOW}No AUR packages configured.${NC}"
        return 0
    fi

    local aur_helper
    if command -v paru &> /dev/null; then
        aur_helper="paru"
    elif command -v yay &> /dev/null; then
        aur_helper="yay"
    else
        echo -e "${YELLOW}No AUR helper found, installing paru...${NC}"
        local build_dependencies=(base-devel git) cargo_status=0
        pacman -T cargo >/dev/null || cargo_status=$?
        case "$cargo_status" in
            0) ;;
            127) build_dependencies+=(rust) ;;
            *) echo "Cannot determine whether a cargo provider is installed." >&2; return "$cargo_status" ;;
        esac
        sudo pacman -S --needed --noconfirm "${build_dependencies[@]}"
        (
            build_dir=$(mktemp -d "${TMPDIR:-/tmp}/yadm-paru.XXXXXX")
            trap 'rm -rf -- "$build_dir"' EXIT
            trap 'exit 130' HUP INT TERM
            git clone --depth 1 https://aur.archlinux.org/paru.git "$build_dir/paru"
            cd "$build_dir/paru"
            makepkg -si --noconfirm
        )
        aur_helper="paru"
    fi

    echo -e "${BLUE}Installing ${#aur_packages[@]} AUR packages...${NC}"
    "$aur_helper" -S --noconfirm --needed "${aur_packages[@]}"
    echo -e "${GREEN}✓ AUR packages installed${NC}"
}

restore_yazi() {
    echo -e "${BLUE}Restoring locked Yazi plugins and flavors...${NC}"
    command -v ya >/dev/null || { echo "ya is required to restore Yazi packages." >&2; return 1; }
    ya pkg install
}

# 4. Rime
setup_rime_grammar() {
    echo -e "${GREEN}[4/8] Installing Rime grammar model...${NC}"

    local rime_dir="$HOME/.local/share/fcitx5/rime"
    local plum_dir="$HOME/.cache/plum"

    mkdir -p "$HOME/.cache"
    if [ ! -d "$plum_dir/.git" ]; then
        git clone https://github.com/rime/plum.git "$plum_dir"
    else
        git -C "$plum_dir" pull --ff-only
    fi

    rime_dir="$rime_dir" bash "$plum_dir/rime-install" iDvel/rime-ice:others/recipes/grammar:schema=rime_ice

    echo -e "${GREEN}✓ Rime grammar model installed${NC}"
}

# 5. Metasploit
setup_security_tools() {
    echo -e "${GREEN}[5/8] Configuring PostgreSQL & Metasploit...${NC}"

    if [ ! -d "/var/lib/postgres/data/base" ]; then
        echo -e "${BLUE}Initializing PostgreSQL database...${NC}"
        sudo -u postgres initdb -D /var/lib/postgres/data
    fi

    echo -e "${BLUE}Starting PostgreSQL service...${NC}"
    sudo systemctl start postgresql.service

    echo -e "${BLUE}Initializing Metasploit database (msfdb)...${NC}"
    msfdb init

    echo -e "${GREEN}✓ Metasploit database initialization completed${NC}"
}

# 6. Services
enable_system_unit() {
    local unit="$1"
    if systemctl cat "$unit" &> /dev/null; then
        sudo systemctl enable "$unit"
    else
        echo -e "${YELLOW}Skip missing unit: $unit${NC}"
    fi
}

enable_user_unit() {
    local unit="$1"
    if systemctl --user cat "$unit" &> /dev/null; then
        systemctl --user enable "$unit"
    else
        echo -e "${YELLOW}Skip missing user unit: $unit${NC}"
    fi
}

enable_services() {
    echo -e "${GREEN}[6/8] Enabling System Services...${NC}"

    enable_system_unit bluetooth.service
    enable_system_unit greetd.service
    enable_system_unit postgresql.service
    enable_system_unit xray.service

    enable_user_unit wireplumber.service
    enable_user_unit pipewire-pulse.service

    echo -e "${GREEN}✓ Services enabled${NC}"
}

# 7. Rust
install_rust() {
    echo -e "${GREEN}[7/8] Preparing Rust (new installs: Stable, Default Profile)${NC}"
    local cargo_bin="${CARGO_HOME:-$HOME/.cargo}/bin" rustup_bin default_toolchain component
    rustup_bin=$(command -v rustup) || rustup_bin=
    if [ -z "$rustup_bin" ] && [ -x "$cargo_bin/rustup" ]; then
        rustup_bin="$cargo_bin/rustup"
        export PATH="$cargo_bin:$PATH"
    fi
    if [ -n "$rustup_bin" ]; then
        echo -e "${GREEN}✓ Existing Rust installation retained; default toolchain is unchanged.${NC}"
        default_toolchain=$(RUSTUP_AUTO_INSTALL=0 "$rustup_bin" default 2>/dev/null) || default_toolchain=
        default_toolchain=${default_toolchain%% *}
        if [ -z "$default_toolchain" ]; then
            echo -e "${YELLOW}No default Rust toolchain is configured; configure it manually when needed.${NC}"
        else
            for component in rustfmt cargo-clippy; do
                if ! RUSTUP_AUTO_INSTALL=0 "$rustup_bin" which --toolchain "$default_toolchain" "$component" >/dev/null 2>&1; then
                    echo -e "${YELLOW}Missing $component for $default_toolchain; existing components were not changed.${NC}"
                fi
            done
        fi
        return 0
    fi
    (
        installer=$(mktemp "${TMPDIR:-/tmp}/yadm-rustup.XXXXXX")
        trap 'rm -f -- "$installer"' EXIT
        trap 'exit 130' HUP INT TERM
        curl --proto '=https' --tlsv1.2 -sSf -o "$installer" https://sh.rustup.rs
        [ -s "$installer" ] || { echo "Downloaded Rust installer is empty." >&2; exit 1; }
        sh "$installer" -y --no-modify-path --profile default --default-toolchain stable
    )
    export PATH="$cargo_bin:$PATH"
}

# 8. Neovim
setup_neovim() {
    echo -e "${GREEN}[8/8] Installing Neovim plugins and Mason tools...${NC}"

    if ! command -v nvim &> /dev/null; then
        echo -e "${YELLOW}nvim not found, skipping Neovim setup${NC}"
        return 0
    fi

    local runtime missing=()
    for runtime in node npm go; do
        command -v "$runtime" >/dev/null || missing+=("$runtime")
    done
    if [ ${#missing[@]} -gt 0 ]; then
        echo "Neovim setup requires these commands in the current PATH: ${missing[*]}" >&2
        echo "Prepare them with your existing runtime manager or system packages, then retry bootstrap." >&2
        return 1
    fi

    nvim --headless "+Lazy! restore" +qa
    nvim --headless "+Lazy! load mason-tool-installer.nvim" "+MasonToolsInstallSync" "+MasonToolsVerify" +qa

    echo -e "${GREEN}✓ Neovim plugins and tools installed${NC}"
}

# Main
main() {
    echo -e "${CYAN}================================================${NC}"
    echo -e "${CYAN}   Bootstrap Sway + InfoSec Environment         ${NC}"
    echo -e "${CYAN}================================================${NC}"

    sync_system
    check_yq
    install_drivers
    install_pacman_packages
    install_aur_packages
    restore_yazi
    setup_rime_grammar
    setup_security_tools
    enable_services
    install_rust
    setup_neovim

    echo -e "${GREEN}================================================${NC}"
    echo -e "${GREEN}✓ Bootstrap complete!${NC}"
    echo -e "${BLUE}Log saved to: $LOG_FILE${NC}"
    echo -e "${YELLOW}================================================${NC}"
    echo -e "${YELLOW}⚠️  MANUAL ACTIONS REQUIRED BEFORE REBOOT:       ${NC}"
    echo -e "${YELLOW}1. Verify ${NC}/etc/greetd/config.toml${YELLOW} uses autologin:${NC}"
    echo -e "${YELLOW}   command = \"sway --unsupported-gpu\"           ${NC}"
    echo -e "${YELLOW}   user = \"nore\"                                 ${NC}"
    echo -e "${YELLOW}2. If you have NVIDIA, check systemd-boot flags! ${NC}"
    echo -e "${YELLOW}================================================${NC}"
}

main
