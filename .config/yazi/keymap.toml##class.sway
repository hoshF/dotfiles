[[mgr.prepend_keymap]]
on   = "l"
run  = "plugin smart-enter"
desc = "Enter the child directory, or open the file"

# <C-g>: open lazygit (switch branch / commit / log...)
[[mgr.prepend_keymap]]
on   = "<C-g>"
run  = 'shell lazygit -p "$(pwd)" --block'
desc = "Open lazygit"

# bunny.yazi: menu-driven directory hops
[[mgr.prepend_keymap]]
on   = [ ";" ]
run  = "plugin bunny"
desc = "bunny: open hop menu"
