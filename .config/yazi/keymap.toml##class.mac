# smart-enter
[[mgr.prepend_keymap]]
on   = "l"
run  = "plugin smart-enter"
desc = "Enter the child directory, or open the file"

# md-open
[[mgr.prepend_keymap]]
on   = "<Enter>"
run  = "plugin md-open"
desc = "Open markdown with Typora, others normally"

# <C-g>: open lazygit (switch branch / commit / log...)
[[mgr.prepend_keymap]]
on   = "<C-g>"
run  = 'shell lazygit -p "$(pwd)" --block'
desc = "Open lazygit"

# Bookmarks (dedukun/bookmarks.yazi): m<key> save, `<key> jump, bd/bD delete
[[mgr.prepend_keymap]]
on   = [ "m" ]
run  = "plugin bookmarks save"
desc = "Save current position as a bookmark"

[[mgr.prepend_keymap]]
on   = [ "`" ]
run  = "plugin bookmarks jump"
desc = "Jump to a bookmark"

[[mgr.prepend_keymap]]
on   = [ "b", "d" ]
run  = "plugin bookmarks delete"
desc = "Delete a bookmark"

[[mgr.prepend_keymap]]
on   = [ "b", "D" ]
run  = "plugin bookmarks delete_all"
desc = "Delete all bookmarks"
