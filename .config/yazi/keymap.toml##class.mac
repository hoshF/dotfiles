# smart-enter
[[mgr.prepend_keymap]]
on   = "l"
run  = "plugin smart-enter"
desc = "Enter the child directory, or open the file"

# md-open
[[mgr.prepend_keymap]]
on   = "<Enter>"
run  = "plugin md-open"
desc = "Open markdown with Typora, others normally"

# <C-g>: open lazygit (switch branch / commit / log...)
[[mgr.prepend_keymap]]
on   = "<C-g>"
run  = 'shell lazygit -p "$(pwd)" --block'
desc = "Open lazygit"
