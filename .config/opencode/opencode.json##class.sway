{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "Build",
  "plugin": ["superpowers@git+https://github.com/obra/superpowers.git"],
  "skills": {
    "paths": ["~/.config/opencode/skills"]
  },
  "mcp": {
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "/home/nore"],
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_TOKEN}"
      },
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": true
    }
  },
  "permission": {
    "edit": "allow",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "bash": {
      "*": "ask",
      "git *": "allow",
      "npm *": "allow",
      "npx *": "allow",
      "pnpm *": "allow",
      "yarn *": "allow",
      "cargo *": "allow",
      "go *": "allow",
      "pip *": "allow",
      "pip3 *": "allow",
      "python3 *": "allow",
      "python *": "allow",
      "node *": "allow",
      "gh *": "allow",
      "ssh *": "allow",
      "which *": "allow",
      "yadm *": "allow",
      "sort *": "allow",
      "jq *": "allow",
      "cut *": "allow",
      "tr *": "allow",
      "xargs *": "allow",
      "uniq *": "allow",
      "ln *": "allow",
      "stat *": "allow",
      "systemctl *": "allow",
      "journalctl *": "allow",
      "pacman *": "allow",
      "kill *": "allow",
      "killall *": "allow",
      "pgrep *": "allow",
      "pkill *": "allow",
      "free *": "allow",
      "top *": "allow",
      "htop *": "allow",
      "lsof *": "allow",
      "ping *": "allow",
      "dig *": "allow",
      "nslookup *": "allow",
      "host *": "allow",
      "ip *": "allow",
      "ss *": "allow",
      "mount *": "allow",
      "umount *": "allow",
      "lsblk *": "allow",
      "base64 *": "allow",
      "strings *": "allow",
      "xxd *": "allow",
      "rsync *": "allow",
      "scp *": "allow",
      "watch *": "allow",
      "echo *": "allow",
      "pwd *": "allow",
      "env *": "allow",
      "date *": "allow",
      "uname *": "allow",
      "uv *": "allow",
      "uvx *": "allow",
      "mkdir *": "allow",
      "cp *": "allow",
      "mv *": "allow",
      "curl *": "allow",
      "wget *": "allow",
      "make *": "allow",
      "tar *": "allow",
      "gzip *": "allow",
      "unzip *": "allow",
      "zip *": "allow",
      "ps *": "allow",
      "file *": "allow",
      "diff *": "allow",
      "wc *": "allow",
      "du *": "allow",
      "df *": "allow",
      "chmod *": "allow",
      "export *": "allow",
      "source *": "allow"
    },
    "external_directory": {
      "*": "allow",
      "~/secrets/**": "deny",
      "~/.ssh/**": "deny"
    }
  }
}
