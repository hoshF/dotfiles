!.ssh/*.pub
.zshenv

# OpenCode local state
.config/opencode/service.json
.config/opencode/node_modules/
.config/opencode/package.json
.config/opencode/package-lock.json

# Shell / tool caches and runtime files
.bun/
.cache/
.zim/
.zcompdump*
.zhistory
.zfm.txt
.wget-hsts
.bash_history
.bash_profile
.bashrc
.bash-preexec.sh

